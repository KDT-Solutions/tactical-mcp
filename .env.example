# Tactical-RMM-API (API-Domain der Instanz)
TRMM_URL=https://api.rmm.example.com
# API-Key des Tactical-Benutzers "mcp" (Settings > Global Settings > API Keys)
TRMM_API_KEY=
TRMM_TLS_VERIFY=1

# 1 = nur lesen
TRMM_READ_ONLY=0
# 1 = Befehle/Scripts ausführen und Scripts, Script-Checks, Script-Tasks anlegen erlauben
# (Default 0 = deaktiviert; Dienste, Prozesse, Neustart, Updates, Alerts usw. gehen trotzdem)
MCP_ALLOW_EXEC=0
# Agents, auf denen nichts ausgeführt/geändert wird (fnmatch, kommagetrennt), z.B. srv-dc*,srv-rmm
PROTECTED_AGENTS=
# Zusätzliche gesperrte Befehlsmuster (Regex, getrennt durch ;;) - die feste Liste gilt immer
BLOCKED_COMMAND_PATTERNS=
# Obergrenze für timeout (Sekunden) und für Ausgaben (Zeichen)
MAX_TIMEOUT=600
MAX_OUTPUT_CHARS=30000

# Statisches Bearer-Token für den Connector (z.B. openssl rand -hex 32, mindestens 32 Zeichen)
MCP_API_KEY=

# Host-Port und Bind-Adresse (nur localhost; sonst die LAN-IP, auf die der Reverse-Proxy zeigt)
MCP_HOST_PORT=8428
MCP_BIND_ADDR=127.0.0.1
